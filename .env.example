# ────────────────────────────────────────────────
# VSJ AI Labs website — environment variables
# Copy to .env.local and fill before deploying.
# ────────────────────────────────────────────────

# Public site URL (used by metadata, sitemap, OG images, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://vsjailabs.com

# ─── Email provider (choose one) ─────────────────
# Resend (recommended)
# Get a key at https://resend.com — verify your domain first
RESEND_API_KEY=
RESEND_FROM=contact@vsjailabs.com

# Postmark (alternative)
# POSTMARK_API_KEY=
# POSTMARK_FROM=contact@vsjailabs.com

# ─── Analytics (consent-gated) ───────────────────
# Plausible (privacy-friendly, GDPR/DPDPA-compliant default)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=vsjailabs.com

# Google Analytics 4 (only with explicit user consent)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Error monitoring ────────────────────────────
# Sentry (recommended for production)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ─── Calendly / scheduling ───────────────────────
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/vsj-ai-labs/intro
