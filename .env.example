# ────────────────────────────────────────────────
# VSJ AI Labs website — environment variables
# Copy to .env.local and fill before deploying.
# ────────────────────────────────────────────────

# Public site URL (used by metadata, sitemap, OG images, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://vsjailabs.com

# ─── Contact form: Email delivery (Resend) ──────
# Get a key at https://resend.com — verify your domain first
RESEND_API_KEY=
RESEND_FROM=contact@vsjailabs.com

# ─── Contact form: CRM Lead creation (ERPNext) ──
# ERPNext v15 on erp.vsjailabs.in — Frappe API keypair.
# Generate at: Desk -> User -> API Access -> Generate keys.
# When set, every contact submission creates a Lead in the CRM in
# parallel with the Resend email delivery.
ERPNEXT_URL=https://erp.vsjailabs.in
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# ─── Analytics (consent-gated via cookie banner) ─
# Plausible: privacy-friendly, GDPR/DPDPA-compliant, no cookies.
# For self-hosted Plausible/Umami on the same Hostinger box, set SRC
# to a same-origin URL to keep CSP maximally strict:
#   NEXT_PUBLIC_PLAUSIBLE_SRC=https://analytics.vsjailabs.com/js/script.js
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=

# ─── Search engine verification ─────────────────
# Google Search Console — meta value from the "HTML tag" method.
NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools — meta value from the "HTML meta tag" method.
NEXT_PUBLIC_BING_VERIFICATION=

# ─── Error monitoring ────────────────────────────
# Sentry (recommended for production)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ─── Calendly / scheduling ───────────────────────
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/vsj-ai-labs/intro
